# Copy to .env and adjust. Everything is optional.

# Web UI port (http://<server>:8092). Put it behind your HTTPS reverse proxy for remote access.
WEB_PORT=8092
# First admin password (otherwise the UI asks for one on first visit). At least 10 characters.
ADMIN_PASSWORD=

# SIP: the local UDP port wa2sip uses for all extensions, and the RTP (audio) port range.
SIP_PORT=5064
RTP_PORT_MIN=17000
RTP_PORT_MAX=17199
# IP address put into SIP/SDP. Empty = the address of the interface that routes to the PBX.
ADVERTISE_IP=

# Local port of the Piper text-to-speech helper (127.0.0.1 only).
PIPER_PORT=18566

# INFO or DEBUG. SIP_TRACE prints every SIP message, WA_TRACE every WhatsApp call state change.
LOG_LEVEL=INFO
SIP_TRACE=false
WA_TRACE=false

# chromium = real WhatsApp Web (normal use). fake = simulated WhatsApp accounts, to try the PBX side.
WA_DRIVER=chromium
# auto = use Chromium's sandbox when the container allows it (needs seccomp-chromium.json), true / false.
CHROMIUM_SANDBOX=auto

# Reverse proxy: which peers may set X-Forwarded-For (private = loopback + RFC 1918, none, or a list).
TRUSTED_PROXIES=private
# Secure cookie flag: auto (when a trusted proxy reports HTTPS), true or false.
SECURE_COOKIES=auto
